// For format details, see https://aka.ms/devcontainer.json.
{
    "name": "ocaml devcontainers examples",
    "build":  {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": "true",
            "username": "vscode",
            "userUid": "1000",
            "userGid": "1000",
            "upgradePackages": "false"
        },
        "./features/ocaml": {
            "version": "${localEnv:OCAML_VERSION}",
            "packages": "ocamlformat#0.28.1 ${localEnv:OCAML_EXTRA_PACKAGES}",
            "system-packages": "${localEnv:OCAML_SYSTEM_PACKAGES}",
            "repositories": "${localEnv:OCAML_OPAM_REPOSITORIES}"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ocamllabs.ocaml-platform"
            ]
        }
    },
    "remoteUser": "vscode",
    "postCreateCommand": {
	"submodules": "git submodule update --init --recursive --depth 1",
        "opam": "sudo sh -ceux \"chown -R $(id -u):$(id -g) ${OPAMROOT}/log\""

    },
    "waitFor": "postCreateCommand"
}
